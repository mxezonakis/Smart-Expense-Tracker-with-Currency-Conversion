<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura,json</Format>
          <Include>[SmartExpenseTracker.Api]*,[SmartExpenseTracker.Application]*,[SmartExpenseTracker.Caching]*,[SmartExpenseTracker.Integrations]*,[SmartExpenseTracker.Persistence]*</Include>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <ExcludeByFile>**/obj/**,**/Migrations/*.Designer.cs,**/Migrations/*ModelSnapshot.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
